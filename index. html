<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexora - Ultimate Public Super App by Noman Bhai</title>
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #131b2e;
            --accent-glow: #a855f7;
            --accent-blue: #38bdf8;
            --text-color: #f8fafc;
            --text-secondary: #94a3b8;
            --border-color: #1e293b;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Language Modal */
        #lang-modal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(7, 11, 20, 0.98);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            padding: 20px;
            justify-content: center;
            align-items: center;
        }
        .modal-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            width: 100%;
            max-width: 400px;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
        }
        .modal-box h2 { font-size: 18px; margin-bottom: 6px; color: #fff; }
        .modal-box p { font-size: 12px; color: var(--text-secondary); margin-bottom: 14px; }
        .lang-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            max-height: 220px;
            overflow-y: auto;
            margin-bottom: 16px;
            padding-right: 4px;
        }
        .lang-btn {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            cursor: pointer;
        }
        .lang-btn:hover { background: var(--accent-glow); }
        .proceed-btn {
            background: linear-gradient(135deg, #a855f7, #38bdf8);
            border: none;
            color: white;
            padding: 12px;
            width: 100%;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
        }

        /* Top Header */
        .top-header {
            background-color: var(--bg-color);
            padding: 12px 16px 8px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            border-bottom: 1px solid var(--border-color);
        }
        .brand-box h1 {
            font-size: 18px;
            font-weight: 900;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .brand-box h1 span { color: var(--accent-blue); }
        .owner-sub { font-size: 11px; color: var(--text-secondary); font-weight: 600; }
        
        .header-icons { display: flex; gap: 10px; }
        .icon-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: #fff;
            width: 36px; height: 36px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            font-size: 16px;
        }

        /* Views Container */
        .view-container {
            flex: 1;
            overflow-y: auto;
            display: none;
            padding: 12px;
            padding-bottom: 75px;
        }
        .view-container.active { display: flex; flex-direction: column; gap: 14px; }

        /* Home View Styles */
        .stories-row {
            display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none;
        }
        .stories-row::-webkit-scrollbar { display: none; }
        .story-item { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; cursor: pointer; }
        .story-ring {
            width: 60px; height: 60px; border-radius: 50%;
            background: linear-gradient(135deg, #a855f7, #38bdf8, #ec4899);
            padding: 2px; display: flex; align-items: center; justify-content: center;
        }
        .story-img {
            width: 56px; height: 56px; border-radius: 50%; background: #334155;
            display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;
            border: 2px solid var(--bg-color);
        }
        .story-name { font-size: 10px; color: var(--text-secondary); }

        /* Filter Pills */
        .filter-row { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
        .filter-row::-webkit-scrollbar { display: none; }
        .filter-pill {
            background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color);
            padding: 6px 14px; border-radius: 20px; font-size: 12px; cursor: pointer; white-space: nowrap;
        }
        .filter-pill.active { background: #fff; color: #0f172a; font-weight: bold; }

        /* Main Video Card */
        .video-main-card { background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); }
        .thumbnail-box {
            width: 100%; height: 170px; background: #1e293b; display: flex; align-items: center; justify-content: center;
            font-size: 32px; position: relative; color: var(--text-secondary);
        }
        .video-duration {
            position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: #fff;
            font-size: 10px; padding: 2px 6px; border-radius: 4px;
        }
        .video-info-row { padding: 10px; display: flex; gap: 10px; }
        .channel-avatar { width: 34px; height: 34px; border-radius: 50%; background: #475569; flex-shrink: 0; }
        .video-meta h4 { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
        .video-meta p { font-size: 11px; color: var(--text-secondary); }

        /* Utility Grid */
        .utility-grid {
            display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px;
            background: var(--card-bg); padding: 12px 8px; border-radius: 12px; border: 1px solid var(--border-color);
        }
        .grid-item { display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; }
        .grid-icon {
            width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.05);
            display: flex; align-items: center; justify-content: center; font-size: 16px;
        }
        .grid-icon.ai { background: linear-gradient(135deg, #a855f7, #38bdf8); color: white; }
        .grid-item span { font-size: 10px; color: var(--text-secondary); }

        /* Real Chat View UI */
        .chat-list { display: flex; flex-direction: column; gap: 8px; }
        .chat-card {
            background: var(--card-bg); border: 1px solid var(--border-color); padding: 10px;
            border-radius: 10px; display: flex; gap: 10px; align-items: center; cursor: pointer;
        }
        .chat-avatar { width: 45px; height: 45px; border-radius: 50%; background: #334155; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .chat-details { flex: 1; }
        .chat-details h4 { font-size: 13px; color: #fff; margin-bottom: 2px; }
        .chat-details p { font-size: 11px; color: var(--text-secondary); }

        /* Active Chat Room Box */
        #active-chat-box {
            display: none; flex-direction: column; height: 100%; background: var(--bg-color);
        }
        .chat-header-bar {
            background: var(--card-bg); padding: 10px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color);
        }
        .chat-messages { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
        .msg { max-width: 75%; padding: 8px 12px; border-radius: 10px; font-size: 12px; }
        .msg.incoming { background: var(--card-bg); align-self: flex-start; border: 1px solid var(--border-color); }
        .msg.outgoing { background: #7c3aed; color: #fff; align-self: flex-end; }
        .chat-input-bar {
            padding: 10px; background: var(--card-bg); display: flex; gap: 8px; border-top: 1px solid var(--border-color);
        }
        .chat-input-bar input {
            flex: 1; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color);
            padding: 8px 12px; border-radius: 20px; color: #fff; font-size: 13px; outline: none;
        }
        .chat-input-bar button {
            background: var(--accent-blue); border: none; color: #000; font-weight: bold; padding: 0 16px; border-radius: 20px; cursor: pointer;
        }

        /* Real AI Assistant View */
        .ai-container { display: flex; flex-direction: column; height: 100%; }
        .ai-box { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-bottom: 10px; }
        .ai-input-row { display: flex; gap: 8px; margin-top: 6px; }
        .ai-input-row input {
            flex: 1; background: var(--card-bg); border: 1px solid var(--border-color); padding: 10px; border-radius: 10px; color: #fff; outline: none;
        }
        .ai-input-row button { background: linear-gradient(135deg, #a855f7, #38bdf8); border: none; color: white; padding: 0 16px; border-radius: 10px; font-weight: bold; cursor: pointer; }

        /* Bottom Navigation */
        .bottom-nav {
            position: fixed; bottom: 0; left: 0; width: 100%; height: 60px;
            background-color: var(--card-bg); border-top: 1px solid var(--border-color);
            display: flex; justify-content: space-around; align-items: center; z-index: 1000;
        }
        .nav-tab {
            background: none; border: none; color: var(--text-secondary); font-size: 10px;
            display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer; flex: 1;
        }
        .nav-tab .icon { font-size: 18px; }
        .nav-tab.active { color: var(--text-color); font-weight: bold; }
        .nav-center-btn {
            width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #a855f7, #38bdf8);
            display: flex; align-items: center; justify-content: center; color: white; font-size: 18px; cursor: pointer; margin-top: -6px;
        }
    </style>
</head>
<body>

    <!-- Language Startup Modal -->
    <div id="lang-modal">
        <div class="modal-box">
            <h2>🌍 Select Language</h2>
            <p>Welcome to Nexora Public Super App</p>
            <div class="lang-grid" id="langGrid"></div>
            <button class="proceed-btn" onclick="startApp()">Start Nexora ›</button>
        </div>
    </div>

    <!-- Header -->
    <div class="top-header">
        <div class="brand-box">
            <h1>NEXORA <span>✓</span></h1>
            <div class="owner-sub">Created by Noman Bhai 👑</div>
        </div>
        <div class="header-icons">
            <button class="icon-btn" onclick="switchView('ai')">✨</button>
            <button class="icon-btn" onclick="alert('12 Notifications available')">🔔</button>
        </div>
    </div>

    <!-- 1. HOME VIEW -->
    <div id="view-home" class="view-container active">
        <div class="stories-row">
            <div class="story-item"><div class="story-ring"><div class="story-img">😎</div></div><span class="story-name">Your Story</span></div>
            <div class="story-item"><div class="story-ring"><div class="story-img" style="background:#ef4444; font-size:10px; font-weight:bold;">LIVE</div></div><span class="story-name">Arslan Live</span></div>
            <div class="story-item"><div class="story-ring"><div class="story-img">👩</div></div><span class="story-name">Sana Khan</span></div>
            <div class="story-item"><div class="story-ring"><div class="story-img">💖</div></div><span class="story-name">Anaya</span></div>
            <div class="story-item"><div class="story-ring"><div class="story-img">🔥</div></div><span class="story-name">Mr Faisu</span></div>
        </div>

        <div class="filter-row">
            <div class="filter-pill active">All</div>
            <div class="filter-pill">Trending</div>
            <div class="filter-pill">Music</div>
            <div class="filter-pill">Gaming</div>
            <div class="filter-pill">Live</div>
        </div>

        <div class="video-main-card">
            <div class="thumbnail-box">🌍<div class="video-duration">12:45</div></div>
            <div class="video-info-row">
                <div class="channel-avatar"></div>
                <div class="video-meta">
                    <h4>Exploring Next-Gen Public Apps 🚀</h4>
                    <p>Noman Bhai • 3.2M views • Public Release</p>
                </div>
            </div>
        </div>

        <div class="utility-grid">
            <div class="grid-item" onclick="switchView('home')"><div class="grid-icon">📡</div><span>Live</span></div>
            <div class="grid-item" onclick="switchView('home')"><div class="grid-icon">▶️</div><span>Videos</span></div>
            <div class="grid-item" onclick="switchView('shorts')"><div class="grid-icon">⚡</div><span>Shorts</span></div>
            <div class="grid-item" onclick="switchView('chat')"><div class="grid-icon" style="color:#22c55e;">💬</div><span>Chat</span></div>
            <div class="grid-item" onclick="switchView('ai')"><div class="grid-icon ai">✨</div><span>AI Hub</span></div>
        </div>
    </div>

    <!-- 2. SHORTS VIEW -->
    <div id="view-shorts" class="view-container">
        <h3 style="font-size:15px; margin-bottom:4px;">⚡ Public Shorts Reel</h3>
        <div style="background:var(--card-bg); height:320px; border-radius:12px; border:1px solid var(--border-color); display:flex; align-items:center; justify-content:center; flex-direction:column; gap:10px;">
            <div style="font-size:40px;">🎬</div>
            <p style="font-size:13px; color:var(--text-secondary);">Shorts Scroll Feed (Smooth & Fast)</p>
            <button onclick="alert('Liked Short!')" style="background:#7c3aed; color:#fff; border:none; padding:8px 16px; border-radius:8px; cursor:pointer;">❤️ Like Short</button>
        </div>
    </div>

    <!-- 3. CHAT VIEW -->
    <div id="view-chat" class="view-container">
        <div id="chat-list-screen">
            <h3 style="font-size:15px; margin-bottom:8px;">💬 Public Chats & Groups</h3>
            <div class="chat-list">
                <div class="chat-card" onclick="openChatRoom('Noman Bhai Community 👑')">
                    <div class="chat-avatar">👑</div>
                    <div class="chat-details">
                        <h4>Noman Bhai Community 👑</h4>
                        <p>Welcome everyone to Nexora Public App!</p>
                    </div>
                </div>
                <div class="chat-card" onclick="openChatRoom('Developer Support')">
                    <div class="chat-avatar">🛠️</div>
                    <div class="chat-details">
                        <h4>Developer Support</h4>
                        <p>Ask anything about Nexora features...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Individual Chat Room -->
        <div id="active-chat-box">
            <div class="chat-header-bar">
                <button onclick="closeChatRoom()" style="background:none; border:none; color:#fff; font-size:16px; cursor:pointer;">← Back</button>
                <h4 id="active-chat-title" style="font-size:14px; color:#fff;">Chat Room</h4>
            </div>
            <div class="chat-messages" id="chatMsgArea">
                <div class="msg incoming">Hello! Welcome to Nexora Public Chat.</div>
            </div>
            <div class="chat-input-bar">
                <input type="text" id="chatInputBox" placeholder="Type a message...">
                <button onclick="sendUserMessage()">Send</button>
            </div>
        </div>
    </div>

    <!-- 4. AI ASSISTANT VIEW -->
    <div id="view-ai" class="view-container">
        <h3 style="font-size:15px;">✨ Nexora AI Assistant (Gemini & ChatGPT Powered)</h3>
        <div class="ai-box" id="aiMsgArea">
            <div class="msg incoming">Hello! I am your AI Assistant built inside Nexora. Ask me anything!</div>
        </div>
        <div class="ai-input-row">
            <input type="text" id="aiInputBox" placeholder="Ask AI a question...">
            <button onclick="askAI()">Ask</button>
        </div>
    </div>

    <!-- 5. PROFILE VIEW -->
    <div id="view-profile" class="view-container" style="align-items:center; text-align:center; justify-content:center;">
        <div style="width:70px; height:70px; background:linear-gradient(135deg, #a855f7, #38bdf8); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:28px; margin-bottom:10px;">👑</div>
        <h3 style="font-size:18px; color:#fff;">Noman Bhai</h3>
        <p style="font-size:12px; color:var(--text-secondary); margin-bottom:14px;">Creator & Founder of Nexora Public Super App</p>
        <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:12px; border-radius:10px; width:100%; max-width:300px; text-align:left; font-size:12px;">
            <p>🌐 <b>Status:</b> Public Live & Active</p>
            <p>🚀 <b>App Version:</b> 2.0 Ultimate Smooth</p>
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="bottom-nav">
        <button class="nav-tab active" id="tab-home" onclick="switchView('home')">
            <span class="icon">🏠</span><span>Home</span>
        </button>
        <button class="nav-tab" id="tab-shorts" onclick="switchView('shorts')">
            <span class="icon">⚡</span><span>Shorts</span>
        </button>
        <div class="nav-center-btn" onclick="switchView('ai')">✦</div>
        <button class="nav-tab" id="tab-chat" onclick="switchView('chat')">
            <span class="icon">💬</span><span>Chat</span>
        </button>
        <button class="nav-tab" id="tab-profile" onclick="switchView('profile')">
            <span class="icon">👤</span><span>Profile</span>
        </button>
    </div>

    <script>
        // Populate Languages
        const languages = ["🇮🇳 हिंदी (Hindi)", "🇬🇧 English", "🇵🇰 اردو (Urdu)", "🇮🇳 मराठी (Marathi)", "🇮🇳 ਪੰਜਾਬੀ (Punjabi)", "🇮🇳 বাংলা (Bengali)", "🇪🇸 Español", "🇸🇦 العربية"];
        const grid = document.getElementById('langGrid');
        languages.forEach((lang, i) => {
            const btn = document.createElement('div');
            btn.className = 'lang-btn';
            btn.innerHTML = lang;
            if(i === 0) btn.style.borderColor = '#38bdf8';
            btn.onclick = () => {
                document.querySelectorAll('.lang-btn').forEach(b => b.style.borderColor = 'var(--border-color)');
                btn.style.borderColor = '#38bdf8';
            };
            grid.appendChild(btn);
        });

        function startApp() {
            document.getElementById('lang-modal').style.display = 'none';
        }

        // View Switcher
        function switchView(viewName) {
            document.querySelectorAll('.view-container').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));

            if(viewName === 'home') {
                document.getElementById('view-home').classList.add('active');
                document.getElementById('tab-home').classList.add('active');
            } else if(viewName === 'shorts') {
                document.getElementById('view-shorts').classList.add('active');
                document.getElementById('tab-shorts').classList.add('active');
            } else if(viewName === 'chat') {
                document.getElementById('view-chat').classList.add('active');
                document.getElementById('tab-chat').classList.add('active');
                document.getElementById('chat-list-screen').style.display = 'block';
                document.getElementById('active-chat-box').style.display = 'none';
            } else if(viewName === 'ai') {
                document.getElementById('view-ai').classList.add('active');
            } else if(viewName === 'profile') {
                document.getElementById('view-profile').classList.add('active');
                document.getElementById('tab-profile').classList.add('active');
            }
        }

        // Chat Room Logic
        function openChatRoom(title) {
            document.getElementById('chat-list-screen').style.display = 'none';
            const box = document.getElementById('active-chat-box');
            box.style.display = 'flex';
            document.getElementById('active-chat-title').innerText = title;
        }
        function closeChatRoom() {
            document.getElementById('active-chat-box').style.display = 'none';
            document.getElementById('chat-list-screen').style.display = 'block';
        }
        function sendUserMessage() {
            const input = document.getElementById('chatInputBox');
            const txt = input.value.trim();
            if(!txt) return;
            const area = document.getElementById('chatMsgArea');
            
            const userMsg = document.createElement('div');
            userMsg.className = 'msg outgoing';
            userMsg.innerText = txt;
            area.appendChild(userMsg);
            input.value = '';
            area.scrollTop = area.scrollHeight;

            setTimeout(() => {
                const reply = document.createElement('div');
                reply.className = 'msg incoming';
                reply.innerText = "Thanks for your message! Nexora Public Community received it.";
                area.appendChild(reply);
                area.scrollTop = area.scrollHeight;
            }, 800);
        }

        // AI Assistant Logic
        function askAI() {
            const input = document.getElementById('aiInputBox');
            const txt = input.value.trim();
            if(!txt) return;
            const area = document.getElementById('aiMsgArea');

            const uMsg = document.createElement('div');
            uMsg.className = 'msg outgoing';
            uMsg.innerText = txt;
            area.appendChild(uMsg);
            input.value = '';
            area.scrollTop = area.scrollHeight;

            setTimeout(() => {
                const aMsg = document.createElement('div');
                aMsg.className = 'msg incoming';
                aMsg.innerText = "Nexora AI Answer: " + txt + " is successfully processed by Noman Bhai's Super App!";
                area.appendChild(aMsg);
                area.scrollTop = area.scrollHeight;
            }, 1000);
        }
    </script>
</body>
</html>
